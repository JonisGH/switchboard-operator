generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CallOutcome {
  AI_RESOLVED
  HUMAN_ACTION_REQUIRED
  TRANSFERRED
  INCOMPLETE
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Call {
  id                    String       @id @default(uuid()) @db.Uuid
  callerReference       String?
  category              String?
  outcome               CallOutcome?
  startedAt             DateTime     @db.Timestamptz(3)
  endedAt               DateTime?    @db.Timestamptz(3)
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  simulationScenarioKey String?
  transcript            String?
  aiSuggestion          Json?
  workOrder             WorkOrder?

  @@index([startedAt(sort: Desc), id(sort: Desc)])
}

model WorkOrder {
  id          String          @id @default(uuid()) @db.Uuid
  callId      String          @unique @db.Uuid
  call        Call            @relation(fields: [callId], references: [id], onDelete: Restrict)
  title       String
  description String?
  status      WorkOrderStatus @default(OPEN)
  createdAt   DateTime        @default(now()) @db.Timestamptz(3)

  @@index([status])
}
